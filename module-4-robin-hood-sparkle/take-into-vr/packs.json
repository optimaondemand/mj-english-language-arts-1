   "title": "Hero or Outlaw?",
   "activities": [
    {
     "name": "Weigh the Evidence",
     "cards": [
      {
       "type": "sign",
       "label": "HERO"
      },
      {
       "type": "sign",
       "label": "OUTLAW"
      },
      {
       "type": "sign",
       "label": "THE LAW ACTS UNJUSTLY"
      },
      {
       "type": "moment",
       "imgs": [
        "fig_guy",
        "fig_robert"
       ],
       "text": "Robert is declared an outlaw and his lands are forfeit"
      },
      {
       "type": "moment",
       "imgs": [
        "fig_archer",
        "fig_much"
       ],
       "text": "The Good Spirit of Sherwood saves Much"
      },
      {
       "type": "moment",
       "imgs": [
        "fig_worman",
        "fig_prince"
       ],
       "text": "Worman betrays his master, and Prince John takes the lands"
      },
      {
       "type": "moment",
       "imgs": [
        "fig_robert",
        "fig_villagers"
       ],
       "text": "Robert sells his lands to help the poor"
      },
      {
       "type": "moment",
       "imgs": [
        "fig_sheriff",
        "fig_stag"
       ],
       "text": "Tales say Robin Hood kills the king’s deer and robs on the highway"
      },
      {
       "type": "moment",
       "imgs": [
        "fig_much",
        "fig_soldiers"
       ],
       "text": "Much is to be punished for killing a deer to feed his children"
